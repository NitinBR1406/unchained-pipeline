# Worker image for the P0-E live bake-off (CI) — V02. Runs a driver worker PHASE so CI can kill/restart it.
FROM python:3.11-slim
WORKDIR /app
ARG TEMPORALIO_VERSION=1.7.1
ARG HATCHET_SDK_VERSION=0.47.0
RUN pip install --no-cache-dir "temporalio==${TEMPORALIO_VERSION}" "hatchet-sdk==${HATCHET_SDK_VERSION}" || \
    pip install --no-cache-dir temporalio hatchet-sdk
COPY common_semantics.py temporal_bakeoff.py hatchet_bakeoff.py controller.py /app/
ENV SE_STORE=/data/se/side_effects.json RESULTS_LOG=/data/se/results.jsonl
CMD ["python","temporal_bakeoff.py","worker"]
